        <di:waypoint x="760" y="210" />
        <di:waypoint x="800" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Script_UserTask_di" bpmnElement="Flow_Script_UserTask">
        <di:waypoint x="1000" y="210" />
        <di:waypoint x="1040" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_UserTask_Join_di" bpmnElement="Flow_UserTask_Join">
