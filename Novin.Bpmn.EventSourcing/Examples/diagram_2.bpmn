        <di:waypoint x="725" y="380" />
        <di:waypoint x="800" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Audit_Wait_di" bpmnElement="Flow_Audit_Wait">
        <di:waypoint x="960" y="380" />
        <di:waypoint x="1000" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Wait_Enrich_di" bpmnElement="Flow_Wait_Enrich">
