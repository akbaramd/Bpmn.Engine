  <bpmn:process id="exclusive_test" name="Exclusive Gateway Test" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:startEvent id="event_start" name="Start">
      <bpmn:outgoing>Flow_Start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Start" sourceRef="event_start" targetRef="Gateway_Fork" />
    <bpmn:exclusiveGateway id="Gateway_Fork" name="Exclusive Fork">
      <bpmn:incoming>Flow_Start</bpmn:incoming>
      <bpmn:outgoing>Flow_Path1</bpmn:outgoing>
      <bpmn:outgoing>Flow_Path2</bpmn:outgoing>
      <bpmn:outgoing>Flow_DefaultPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Path1" name="Path 1" sourceRef="Gateway_Fork" targetRef="Activity_1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Instance.Variables.path == 1</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Path2" name="Path 2" sourceRef="Gateway_Fork" targetRef="Activity_2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Instance.Variables.path == 2</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DefaultPath" name="Default Path" sourceRef="Gateway_Fork" targetRef="Activity_3" />
    <bpmn:scriptTask id="Activity_1" name="Activity 1">
      <bpmn:incoming>Flow_Path1</bpmn:incoming>
      <bpmn:outgoing>Flow_1_to_Join</bpmn:outgoing>
      <bpmn:script>Console.WriteLine("Executing Activity 1");
Instance.Variables.activityExecuted = "Activity_1";</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Activity_2" name="Activity 2">
      <bpmn:incoming>Flow_Path2</bpmn:incoming>
      <bpmn:outgoing>Flow_2_to_Join</bpmn:outgoing>
      <bpmn:script>Console.WriteLine("Executing Activity 2");
Instance.Variables.activityExecuted = "Activity_2";</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Activity_3" name="Activity 3">
      <bpmn:incoming>Flow_DefaultPath</bpmn:incoming>
      <bpmn:outgoing>Flow_3_to_Join</bpmn:outgoing>
      <bpmn:script>Console.WriteLine("Executing Activity 3");
Instance.Variables.activityExecuted = "Activity_3";</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_1_to_Join" sourceRef="Activity_1" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_2_to_Join" sourceRef="Activity_2" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_3_to_Join" sourceRef="Activity_3" targetRef="Gateway_Join" />
    <bpmn:exclusiveGateway id="Gateway_Join" name="Exclusive Join">
      <bpmn:incoming>Flow_1_to_Join</bpmn:incoming>
      <bpmn:incoming>Flow_2_to_Join</bpmn:incoming>
      <bpmn:incoming>Flow_3_to_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_to_End</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_to_End" sourceRef="Gateway_Join" targetRef="Activity_4" />
    <bpmn:scriptTask id="Activity_4" name="Activity 4">
      <bpmn:incoming>Flow_to_End</bpmn:incoming>
      <bpmn:outgoing>Flow_to_event_end</bpmn:outgoing>
      <bpmn:script>Console.WriteLine("Executing Activity 4");
Instance.Variables.completed = true;</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_to_event_end" sourceRef="Activity_4" targetRef="event_end" />
    <bpmn:endEvent id="event_end" name="End">
      <bpmn:incoming>Flow_to_event_end</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
