# GET    /api/process-execution/{id}/stats   - Get execution stats
# GET    /api/process-execution/{id}/path    - Get execution path
# GET    /api/process-execution/{id}/audit-stats - Get audit stats

# INCIDENT ENDPOINTS (7 endpoints)
