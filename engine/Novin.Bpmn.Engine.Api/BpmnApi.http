### ========================================================================
### INTEGRATION EXAMPLES
### ========================================================================

### JavaScript Client Integration
###
// Deploy process
const deployResponse = await fetch('/api/deployments', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
        processKey: 'order-process',
        bpmnXml: bpmnContent,
        label: 'Order Processing Workflow'
    })
});

// Start process instance
const startResponse = await fetch('/api/processes/start', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
        processKey: 'order-process',
        businessKey: 'order-123',
        variables: { amount: 99.99, customer: 'john@example.com' }
    })
});
const processData = await startResponse.json();

// Monitor execution
const executionFlow = await fetch(`/api/process-execution/${processData.processId}/flow`);
const flowData = await executionFlow.json();

// Handle incidents
const incidents = await fetch(`/api/incidents/process/${processData.processId}`);
const incidentData = await incidents.json();

if (incidentData.length > 0) {
    // Resolve incidents
    for (const incident of incidentData) {
        await fetch(`/api/incidents/${incident.id}/resolve`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                message: 'Issue resolved automatically'
            })
        });
    }
}
###

### ========================================================================
### COMPLETE API REFERENCE SUMMARY
### ========================================================================

# DEPLOYMENT ENDPOINTS (7 endpoints)
# POST   /api/deployments                    - Deploy process
# GET    /api/deployments                    - List deployments
# GET    /api/deployments/{id}               - Get deployment
# GET    /api/deployments/{id}/xml           - Get BPMN XML
# GET    /api/deployments/by-key/{key}       - Get by process key
# POST   /api/deployments/{id}/activate      - Activate deployment
# POST   /api/deployments/{id}/deactivate    - Deactivate deployment
# DELETE /api/deployments/{id}               - Delete deployment

# PROCESS ENDPOINTS (12 endpoints)
# POST   /api/processes/start                - Start process
# GET    /api/processes                      - List processes
# GET    /api/processes/{id}                 - Get process
# POST   /api/processes/{id}/complete        - Complete process
# DELETE /api/processes/{id}                 - Delete process
# POST   /api/processes/{id}/suspend         - Suspend process
# POST   /api/processes/{id}/resume          - Resume process
# POST   /api/processes/{id}/message         - Send message
# POST   /api/processes/signal               - Send signal
# GET    /api/processes/{id}/variables       - Get variables
# PUT    /api/processes/{id}/variables       - Set variables
# GET    /api/processes/stats                - Get statistics

# EXECUTION ENDPOINTS (4 endpoints)
# GET    /api/process-execution/{id}/flow    - Get execution flow
# GET    /api/process-execution/{id}/stats   - Get execution stats
# GET    /api/process-execution/{id}/path    - Get execution path
# GET    /api/process-execution/{id}/audit-stats - Get audit stats

# INCIDENT ENDPOINTS (7 endpoints)
# GET    /api/incidents                      - List incidents
# GET    /api/incidents/process/{id}         - Get by process
# GET    /api/incidents/{id}                 - Get incident
# POST   /api/incidents/{id}/resolve         - Resolve incident
# DELETE /api/incidents/{id}                 - Delete incident
# GET    /api/incidents/stats                - Get statistics

# TEST SCENARIO ENDPOINTS (4 endpoints)
# GET    /api/test-scenarios                 - List scenarios
# POST   /api/test-scenarios/{name}/run      - Run scenario
# POST   /api/test-scenarios/run-all         - Run all scenarios
# GET    /api/test-scenarios/{name}/status   - Get status

# TOTAL: 34 comprehensive API endpoints for complete BPMN process management!