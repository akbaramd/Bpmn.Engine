###

### Deploy BPMN with Error Boundary Events
POST http://localhost:5000/api/deployments
Content-Type: application/json

{
  "deploymentKey": "error-handling-process",
  "bpmnXml": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\">\n  <bpmn:process id=\"error-handling-process\" isExecutable=\"true\">\n    <bpmn:startEvent id=\"StartEvent_1\" name=\"Start\">\n      <bpmn:outgoing>Flow_1</bpmn:outgoing>\n    </bpmn:startEvent>\n    <bpmn:scriptTask id=\"ErrorTask\" name=\"Task That May Fail\" scriptFormat=\"csharp\">\n      <bpmn:incoming>Flow_1</bpmn:incoming>\n      <bpmn:outgoing>Flow_2</bpmn:outgoing>\n      <bpmn:script>throw new Exception(\"Simulated error\");</bpmn:script>\n    </bpmn:scriptTask>\n    <bpmn:boundaryEvent id=\"ErrorBoundary\" name=\"Error Handler\" attachedToRef=\"ErrorTask\">\n      <bpmn:errorEventDefinition errorRef=\"Error_1\" />\n      <bpmn:outgoing>Flow_3</bpmn:outgoing>\n    </bpmn:boundaryEvent>\n    <bpmn:scriptTask id=\"CompensationTask\" name=\"Error Compensation\" scriptFormat=\"csharp\">\n      <bpmn:incoming>Flow_3</bpmn:incoming>\n      <bpmn:outgoing>Flow_4</bpmn:outgoing>\n      <bpmn:script>Console.WriteLine(\"Handling error...\");</bpmn:script>\n    </bpmn:scriptTask>\n    <bpmn:endEvent id=\"EndEvent_1\" name=\"End Success\">\n      <bpmn:incoming>Flow_2</bpmn:incoming>\n    </bpmn:endEvent>\n    <bpmn:endEvent id=\"EndEvent_2\" name=\"End Error\">\n      <bpmn:incoming>Flow_4</bpmn:incoming>\n    </bpmn:endEvent>\n    <bpmn:sequenceFlow id=\"Flow_1\" sourceRef=\"StartEvent_1\" targetRef=\"ErrorTask\" />\n    <bpmn:sequenceFlow id=\"Flow_2\" sourceRef=\"ErrorTask\" targetRef=\"EndEvent_1\" />\n    <bpmn:sequenceFlow id=\"Flow_3\" sourceRef=\"ErrorBoundary\" targetRef=\"CompensationTask\" />\n    <bpmn:sequenceFlow id=\"Flow_4\" sourceRef=\"CompensationTask\" targetRef=\"EndEvent_2\" />\n  </bpmn:process>\n  <bpmn:error id=\"Error_1\" name=\"TestError\" errorCode=\"TEST_ERROR\" />\n</bpmn:definitions>",
  "label": "Error Boundary Event Process"
}

###

### Deploy BPMN with Timer Events
POST http://localhost:5000/api/deployments
Content-Type: application/json

{
  "deploymentKey": "timer-process",
  "bpmnXml": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\">\n  <bpmn:process id=\"timer-process\" isExecutable=\"true\">\n    <bpmn:startEvent id=\"StartEvent_1\" name=\"Start\" />\n    <bpmn:userTask id=\"UserTask_1\" name=\"Review Task\" />\n    <bpmn:boundaryEvent id=\"TimerBoundary\" name=\"Escalation Timer\" attachedToRef=\"UserTask_1\" cancelActivity=\"true\">\n      <bpmn:timerEventDefinition>\n        <bpmn:timeDuration>PT5M</bpmn:timeDuration>\n      </bpmn:timerEventDefinition>\n    </bpmn:boundaryEvent>\n    <bpmn:scriptTask id=\"EscalationTask\" name=\"Send Escalation\" />\n    <bpmn:endEvent id=\"EndEvent_1\" name=\"Completed\" />\n    <bpmn:endEvent id=\"EndEvent_2\" name=\"Escalated\" />\n    <bpmn:sequenceFlow id=\"Flow_1\" sourceRef=\"StartEvent_1\" targetRef=\"UserTask_1\" />\n    <bpmn:sequenceFlow id=\"Flow_2\" sourceRef=\"UserTask_1\" targetRef=\"EndEvent_1\" />\n    <bpmn:sequenceFlow id=\"Flow_3\" sourceRef=\"TimerBoundary\" targetRef=\"EscalationTask\" />\n    <bpmn:sequenceFlow id=\"Flow_4\" sourceRef=\"EscalationTask\" targetRef=\"EndEvent_2\" />\n  </bpmn:process>\n</bpmn:definitions>",
  "label": "Timer Boundary Event Process"
}

###

### Deploy BPMN with Parallel Gateway
POST http://localhost:5000/api/deployments
Content-Type: application/json

{
  "deploymentKey": "parallel-gateway-process",
  "bpmnXml": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\">\n  <bpmn:process id=\"parallel-gateway-process\" isExecutable=\"true\">\n    <bpmn:startEvent id=\"StartEvent_1\" name=\"Start\" />\n    <bpmn:parallelGateway id=\"SplitGateway\" name=\"Split\" />\n    <bpmn:userTask id=\"TaskA\" name=\"Process Payment\" />\n    <bpmn:userTask id=\"TaskB\" name=\"Send Confirmation\" />\n    <bpmn:userTask id=\"TaskC\" name=\"Update Inventory\" />\n    <bpmn:parallelGateway id=\"JoinGateway\" name=\"Join\" />\n    <bpmn:endEvent id=\"EndEvent_1\" name=\"All Done\" />\n    <bpmn:sequenceFlow id=\"Flow_1\" sourceRef=\"StartEvent_1\" targetRef=\"SplitGateway\" />\n    <bpmn:sequenceFlow id=\"Flow_2\" sourceRef=\"SplitGateway\" targetRef=\"TaskA\" />\n    <bpmn:sequenceFlow id=\"Flow_3\" sourceRef=\"SplitGateway\" targetRef=\"TaskB\" />\n    <bpmn:sequenceFlow id=\"Flow_4\" sourceRef=\"SplitGateway\" targetRef=\"TaskC\" />\n    <bpmn:sequenceFlow id=\"Flow_5\" sourceRef=\"TaskA\" targetRef=\"JoinGateway\" />\n    <bpmn:sequenceFlow id=\"Flow_6\" sourceRef=\"TaskB\" targetRef=\"JoinGateway\" />\n    <bpmn:sequenceFlow id=\"Flow_7\" sourceRef=\"TaskC\" targetRef=\"JoinGateway\" />\n    <bpmn:sequenceFlow id=\"Flow_8\" sourceRef=\"JoinGateway\" targetRef=\"EndEvent_1\" />\n  </bpmn:process>\n</bpmn:definitions>",
  "label": "Parallel Processing Workflow"
}

###

### Deploy BPMN with Exclusive Gateway (XOR)
POST http://localhost:5000/api/deployments
Content-Type: application/json

{
  "deploymentKey": "exclusive-gateway-process",
  "bpmnXml": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\">\n  <bpmn:process id=\"exclusive-gateway-process\" isExecutable=\"true\">\n    <bpmn:startEvent id=\"StartEvent_1\" name=\"Order Received\" />\n    <bpmn:exclusiveGateway id=\"DecisionGateway\" name=\"Check Amount\" />\n    <bpmn:userTask id=\"ApproveTask\" name=\"Manager Approval\" />\n    <bpmn:userTask id=\"AutoTask\" name=\"Auto Processing\" />\n    <bpmn:endEvent id=\"EndEvent_1\" name=\"Order Processed\" />\n    <bpmn:sequenceFlow id=\"Flow_1\" sourceRef=\"StartEvent_1\" targetRef=\"DecisionGateway\" />\n    <bpmn:sequenceFlow id=\"Flow_2\" sourceRef=\"DecisionGateway\" targetRef=\"ApproveTask\">\n      <bpmn:conditionExpression xsi:type=\"bpmn:tFormalExpression\">amount > 1000</bpmn:conditionExpression>\n    </bpmn:sequenceFlow>\n    <bpmn:sequenceFlow id=\"Flow_3\" sourceRef=\"DecisionGateway\" targetRef=\"AutoTask\">\n      <bpmn:conditionExpression xsi:type=\"bpmn:tFormalExpression\">amount <= 1000</bpmn:conditionExpression>\n    </bpmn:sequenceFlow>\n    <bpmn:sequenceFlow id=\"Flow_4\" sourceRef=\"ApproveTask\" targetRef=\"EndEvent_1\" />\n    <bpmn:sequenceFlow id=\"Flow_5\" sourceRef=\"AutoTask\" targetRef=\"EndEvent_1\" />\n  </bpmn:process>\n</bpmn:definitions>",
  "label": "Conditional Approval Workflow"
}

###

### Deploy BPMN with Message Events
POST http://localhost:5000/api/deployments
Content-Type: application/json

{
  "deploymentKey": "message-process",
  "bpmnXml": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\">\n  <bpmn:process id=\"message-process\" isExecutable=\"true\">\n    <bpmn:startEvent id=\"StartEvent_1\" name=\"Start\" />\n    <bpmn:intermediateCatchEvent id=\"MessageEvent\" name=\"Wait for Payment\">\n      <bpmn:messageEventDefinition messageRef=\"PaymentMessage\" />\n    </bpmn:intermediateCatchEvent>\n    <bpmn:userTask id=\"ProcessPayment\" name=\"Process Payment\" />\n    <bpmn:endEvent id=\"EndEvent_1\" name=\"Payment Complete\" />\n    <bpmn:sequenceFlow id=\"Flow_1\" sourceRef=\"StartEvent_1\" targetRef=\"MessageEvent\" />\n    <bpmn:sequenceFlow id=\"Flow_2\" sourceRef=\"MessageEvent\" targetRef=\"ProcessPayment\" />\n    <bpmn:sequenceFlow id=\"Flow_3\" sourceRef=\"ProcessPayment\" targetRef=\"EndEvent_1\" />\n  </bpmn:process>\n  <bpmn:message id=\"PaymentMessage\" name=\"PaymentReceived\" />\n</bpmn:definitions>",
  "label": "Message-Driven Process"
}

###

### Deploy BPMN with Sub-Process
POST http://localhost:5000/api/deployments
Content-Type: application/json

{
  "deploymentKey": "subprocess-example",
  "bpmnXml": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\">\n  <bpmn:process id=\"subprocess-example\" isExecutable=\"true\">\n    <bpmn:startEvent id=\"StartEvent_1\" name=\"Order Started\" />\n    <bpmn:subProcess id=\"OrderProcessing\" name=\"Process Order\">\n      <bpmn:startEvent id=\"SubStart\" name=\"Start Processing\" />\n      <bpmn:userTask id=\"ValidateOrder\" name=\"Validate Order\" />\n      <bpmn:userTask id=\"PrepareShipment\" name=\"Prepare Shipment\" />\n      <bpmn:endEvent id=\"SubEnd\" name=\"Processing Complete\" />\n      <bpmn:sequenceFlow id=\"SubFlow_1\" sourceRef=\"SubStart\" targetRef=\"ValidateOrder\" />\n      <bpmn:sequenceFlow id=\"SubFlow_2\" sourceRef=\"ValidateOrder\" targetRef=\"PrepareShipment\" />\n      <bpmn:sequenceFlow id=\"SubFlow_3\" sourceRef=\"PrepareShipment\" targetRef=\"SubEnd\" />\n    </bpmn:subProcess>\n    <bpmn:userTask id=\"SendNotification\" name=\"Send Confirmation\" />\n    <bpmn:endEvent id=\"EndEvent_1\" name=\"Order Complete\" />\n    <bpmn:sequenceFlow id=\"Flow_1\" sourceRef=\"StartEvent_1\" targetRef=\"OrderProcessing\" />\n    <bpmn:sequenceFlow id=\"Flow_2\" sourceRef=\"OrderProcessing\" targetRef=\"SendNotification\" />\n    <bpmn:sequenceFlow id=\"Flow_3\" sourceRef=\"SendNotification\" targetRef=\"EndEvent_1\" />\n  </bpmn:process>\n</bpmn:definitions>",
  "label": "Sub-Process Example"
}

