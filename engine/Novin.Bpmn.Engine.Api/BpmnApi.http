### JavaScript Example - Deploy and Start Process with CORS
###
// This will work from any origin due to CORS configuration
const deployAndStartProcess = async () => {
    try {
        // 1. Deploy BPMN process
        const deployResponse = await fetch('http://localhost:5000/api/deployments', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                deploymentKey: 'order-process',
                bpmnXml: `<?xml version="1.0" encoding="UTF-8"?>
                    <bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL">
                        <bpmn:process id="order-process" isExecutable="true">
                            <bpmn:startEvent id="StartEvent_1" name="Order Received"/>
                            <bpmn:userTask id="UserTask_1" name="Process Order"/>
                            <bpmn:endEvent id="EndEvent_1" name="Order Completed"/>
                            <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="UserTask_1"/>
                            <bpmn:sequenceFlow id="Flow_2" sourceRef="UserTask_1" targetRef="EndEvent_1"/>
                        </bpmn:process>
                    </bpmn:definitions>`,
                label: 'Order Processing Workflow'
            })
        });

        const deployResult = await deployResponse.json();
        console.log('Deployment created:', deployResult);

        // 2. Start process instance
        const startResponse = await fetch('http://localhost:5000/api/processes/start', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                processDefinitionId: 'order-process',
                processName: 'Order Process Instance',
                initialVariables: {
                    orderId: 'ORD-12345',
                    amount: 99.99,
                    customerEmail: 'customer@example.com'
                }
            })
        });

        const processResult = await startResponse.json();
        console.log('Process started:', processResult);

        // 3. Get process with model information
        const modelResponse = await fetch(`http://localhost:5000/api/processes/with-models?includeModel=true`);
        const processesWithModels = await modelResponse.json();
        console.log('Processes with models:', processesWithModels);

        // 4. Check health
        const healthResponse = await fetch('http://localhost:5000/health');
        const healthStatus = await healthResponse.text();
        console.log('Health status:', healthStatus);

    } catch (error) {
        console.error('Error:', error);
    }
};

// Call the function
deployAndStartProcess();
###

### React/Vue/Angular Example - BPMN Process Viewer
###
// Component to display BPMN processes with models
const BpmnProcessViewer = () => {
    const [processes, setProcesses] = useState([]);
    const [selectedProcess, setSelectedProcess] = useState(null);

    useEffect(() => {
        // Fetch processes with models (CORS enabled)
        fetch('http://localhost:5000/api/processes/with-models?includeModel=true')
            .then(response => response.json())
            .then(data => setProcesses(data))
            .catch(error => console.error('Error fetching processes:', error));
    }, []);

    const handleProcessSelect = (process) => {
        setSelectedProcess(process);
        // Here you could integrate with bpmn-js to display the BPMN diagram
        if (process.bpmnModel) {
            console.log('BPMN Model:', JSON.parse(process.bpmnModel));
        }
    };

    return (
        <div>
            <h2>BPMN Processes</h2>
            <ul>
                {processes.map(proc => (
                    <li key={proc.process.id} onClick={() => handleProcessSelect(proc)}>
                        {proc.process.name} - {proc.process.state}
                        {proc.hasModel && <span> (Model Available)</span>}
                    </li>
                ))}
            </ul>

            {selectedProcess && (
                <div>
                    <h3>Process Details</h3>
                    <pre>{JSON.stringify(selectedProcess, null, 2)}</pre>
                </div>
            )}
        </div>
    );
};
