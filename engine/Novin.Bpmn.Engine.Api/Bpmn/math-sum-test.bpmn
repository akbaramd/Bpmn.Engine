<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bonyan="http://bonyan.org/schema/bpmn/1.0" id="Definitions_math_sum_test" targetNamespace="http://novin-bpmn/test">
  <bpmn:process id="math-sum-test" name="Math Sum Test" isExecutable="true">
    <bpmn:startEvent id="start" name="Start">
      <bpmn:outgoing>f_start_to_input</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="setupNumbers" name="Setup Numbers (C#)" scriptFormat="C#">
      <bpmn:extensionElements>
        <bonyan:ioMapping onMissingSource="null" onMissingOutput="skip" overwrite="true">
          <bonyan:output source="number1" target="number1" />
          <bonyan:output source="number2" target="number2" />
        </bonyan:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>f_start_to_input</bpmn:incoming>
      <bpmn:outgoing>f_input_to_sum</bpmn:outgoing>
      <bpmn:script><![CDATA[
        // ===== [setupNumbers] FIRST TASK: Setting up and outputting variables =====
        Console.WriteLine("[setupNumbers] ========================================");
        Console.WriteLine("[setupNumbers] Setting up test numbers and outputting to process");

        // Set test numbers using BonyanVariables typed methods
        Context.Variables.SetDecimal("number1", 15.5m);
        Context.Variables.SetDecimal("number2", 24.7m);

        var num1 = Context.Variables.GetDecimal("number1", 0m);
        var num2 = Context.Variables.GetDecimal("number2", 0m);
        Console.WriteLine("[setupNumbers] ✓ Set number1 = {0}", num1);
        Console.WriteLine("[setupNumbers] ✓ Set number2 = {0}", num2);

        // Output these variables to the process via ioMapping
        // This makes them available to subsequent tasks including the service task
        Console.WriteLine("[setupNumbers] 📤 Outputting variables to process context...");
        Console.WriteLine("[setupNumbers] ✅ Variables setup and output completed");
        Console.WriteLine("[setupNumbers] ========================================");
      ]]></bpmn:script>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="sumTask" name="Sum Numbers" implementation="bpmn-client-demo@SumNumbers">
      <bpmn:extensionElements>
        <bonyan:ioMapping onMissingSource="null" onMissingOutput="skip" overwrite="true">
          <!-- Input variables from process (set by setupNumbers script task) -->
          <bonyan:input source="number1" target="number1" />
          <bonyan:input source="number2" target="number2" />
          <!-- Output result back to process -->
          <bonyan:output source="sum" target="sum" />
        </bonyan:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>f_input_to_sum</bpmn:incoming>
      <bpmn:outgoing>f_sum_to_result</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="verifyInputs" name="Verify Service Task Inputs (C#)" scriptFormat="C#">
      <bpmn:extensionElements>
        <bonyan:ioMapping onMissingSource="null" onMissingOutput="skip" overwrite="true">
          <bonyan:input source="number1" target="input_number1" />
          <bonyan:input source="number2" target="input_number2" />
        </bonyan:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>f_sum_to_result</bpmn:incoming>
      <bpmn:outgoing>f_verify_to_display</bpmn:outgoing>
      <bpmn:script><![CDATA[
        // ===== [verifyInputs] THIRD TASK: Verifying service task received inputs =====
        Console.WriteLine("[verifyInputs] ========================================");
        Console.WriteLine("[verifyInputs] Verifying that service task received input variables");

        // Check if we can access the input variables from the process
        Console.WriteLine("[verifyInputs] Checking process variables...");

        if (Context.Variables.Has("number1"))
        {
            var num1 = Context.Variables.GetDecimal("number1");
            Console.WriteLine("[verifyInputs] ✓ Found number1 in process: {0}", num1);
        }
        else
        {
            Console.WriteLine("[verifyInputs] ❌ number1 not found in process variables");
        }

        if (Context.Variables.Has("number2"))
        {
            var num2 = Context.Variables.GetDecimal("number2");
            Console.WriteLine("[verifyInputs] ✓ Found number2 in process: {0}", num2);
        }
        else
        {
            Console.WriteLine("[verifyInputs] ❌ number2 not found in process variables");
        }

        // Check for the result from service task
        if (Context.Variables.Has("sum"))
        {
            var sum = Context.Variables.GetDecimal("sum");
            Console.WriteLine("[verifyInputs] ✓ Found sum result from service task: {0}", sum);
        }
        else
        {
            Console.WriteLine("[verifyInputs] ❌ sum result not found from service task");
        }

        Console.WriteLine("[verifyInputs] ✅ Input verification completed");
        Console.WriteLine("[verifyInputs] ========================================");
      ]]></bpmn:script>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="displayResult" name="Display Final Result (C#)" scriptFormat="C#">
      <bpmn:extensionElements>
        <bonyan:ioMapping onMissingSource="null" onMissingOutput="skip" overwrite="true">
          <bonyan:input source="sum" target="final_sum" />
        </bonyan:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>f_verify_to_display</bpmn:incoming>
      <bpmn:outgoing>f_result_to_end</bpmn:outgoing>
      <bpmn:script><![CDATA[
        // ===== [displayResult] FOURTH TASK: Displaying final calculation result =====
        Console.WriteLine("[displayResult] ========================================");
        Console.WriteLine("[displayResult] Displaying final calculation result");

        if (Context.Variables.Has("sum"))
        {
            var sum = Context.Variables.GetDecimal("sum", 0m);
            Console.WriteLine("[displayResult] 🎯 Final calculation result: {0}", sum);

            // Expected result: 15.5 + 24.7 = 40.2
            Console.WriteLine("[displayResult] ✅ Expected: 15.5 + 24.7 = 40.2");
            Console.WriteLine("[displayResult] ✅ Actual: {0}", sum);
        }
        else
        {
            Console.WriteLine("[displayResult] ❌ No sum variable found in final result!");
        }

        Console.WriteLine("[displayResult] ✅ Final result display completed");
        Console.WriteLine("[displayResult] ========================================");
      ]]></bpmn:script>
    </bpmn:scriptTask>
    <bpmn:endEvent id="end" name="End">
      <bpmn:incoming>f_result_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_start_to_input" sourceRef="start" targetRef="setupNumbers" />
    <bpmn:sequenceFlow id="f_input_to_sum" sourceRef="setupNumbers" targetRef="sumTask" />
    <bpmn:sequenceFlow id="f_sum_to_result" sourceRef="sumTask" targetRef="verifyInputs" />
    <bpmn:sequenceFlow id="f_verify_to_display" sourceRef="verifyInputs" targetRef="displayResult" />
    <bpmn:sequenceFlow id="f_result_to_end" sourceRef="displayResult" targetRef="end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_math_sum_test">
    <bpmndi:BPMNPlane id="BPMNPlane_math_sum_test" bpmnElement="math-sum-test">
      <bpmndi:BPMNShape id="BPMNShape_start" bpmnElement="start">
        <dc:Bounds x="100" y="200" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_setupNumbers" bpmnElement="setupNumbers">
        <dc:Bounds x="180" y="178" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_sumTask" bpmnElement="sumTask">
        <dc:Bounds x="320" y="178" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_verifyInputs" bpmnElement="verifyInputs">
        <dc:Bounds x="460" y="178" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_displayResult" bpmnElement="displayResult">
        <dc:Bounds x="600" y="178" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_end" bpmnElement="end">
        <dc:Bounds x="740" y="200" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_f_start_to_input" bpmnElement="f_start_to_input">
        <di:waypoint x="136" y="218" />
        <di:waypoint x="180" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_input_to_sum" bpmnElement="f_input_to_sum">
        <di:waypoint x="280" y="218" />
        <di:waypoint x="320" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_sum_to_result" bpmnElement="f_sum_to_result">
        <di:waypoint x="420" y="218" />
        <di:waypoint x="460" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_verify_to_display" bpmnElement="f_verify_to_display">
        <di:waypoint x="560" y="218" />
        <di:waypoint x="600" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f_result_to_end" bpmnElement="f_result_to_end">
        <di:waypoint x="700" y="218" />
        <di:waypoint x="740" y="218" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>