### Client JavaScript Example for Visualization
###
### // Fetch execution data
### const response = await fetch('/api/process-execution/{processId}/flow');
### const data = await response.json();
###
### // Highlight executed elements in BPMN.js
### data.executedElements.forEach(element => {
###   const bpmnElement = viewer.get('elementRegistry').get(element.elementId);
###   if (bpmnElement) {
###     viewer.get('modeling').setColor(bpmnElement, {
###       stroke: '#52b415',
###       fill: '#e8f5e8'
###     });
###   }
### });
###
### // Highlight executed flows
### data.executedFlows.forEach(flow => {
###   const bpmnFlow = viewer.get('elementRegistry').get(flow.flowId);
###   if (bpmnFlow) {
###     viewer.get('modeling').setColor(bpmnFlow, {
###       stroke: '#52b415',
###       strokeWidth: 3
###     });
###   }
### });
###
### // Show boundary event status
### data.boundaryEvents.forEach(boundary => {
###   if (boundary.state === 'Triggered') {
###     const element = viewer.get('elementRegistry').get(boundary.boundaryEventId);
###     if (element) {
###       viewer.get('modeling').setColor(element, {
###         stroke: '#cc0000',
###         fill: '#ffcccc'
###       });
###     }
###   }
### });