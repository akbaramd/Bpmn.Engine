@using Microsoft.AspNetCore.Mvc.TagHelpers
@model List<BpmnDeploymentDetails>

<div class="row mb-4">
    <div class="col-md-7">
        <div class="card card-body">
            <h1 class="mb-3">BPMN Deployments</h1>
            <p>All deployed process definitions in the system.</p>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card card-body">
            <h3 class="mb-3">Deploy New Process</h3>
            <form method="post" enctype="multipart/form-data" asp-action="Upload">
                <div class="mb-3">
                    <label for="deploymentKey" class="form-label">Deployment Key</label>
                    <input type="text" class="form-control" id="deploymentKey" name="deploymentKey" required>
                    <div class="form-text">Unique identifier for this deployment (e.g., "order-process").</div>
                </div>
                <div class="mb-3">
                    <label for="label" class="form-label">Label (Optional)</label>
                    <input type="text" class="form-control" id="label" name="label">
                    <div class="form-text">Human-readable name or comment.</div>
                </div>
                <div class="mb-3">
                    <label for="file" class="form-label">BPMN File</label>
                    <input type="file" class="form-control" id="file" name="file" required accept=".bpmn,.xml">
                    <div class="form-text">Upload a BPMN 2.0 XML file.</div>
                </div>
                <button type="submit" class="btn btn-primary">Upload & Deploy</button>
            </form>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model.Any())
{
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-6 mb-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">@item.Deployment.DeploymentKey</h5>
                        <p class="card-text">
                            <span class="text-muted">Version:</span> @item.Deployment.Version<br />
                            <span class="text-muted">Deployed At:</span> @item.Deployment.DeployedAt.ToLocalTime()
                        </p>

                        @if (item.Topologies.Any())
                        {
                            <p><strong>Processes:</strong></p>
                            <ul class="mb-2">
                                @foreach (var process in item.Topologies)
                                {
                                    <li>
                                        <code>@process.ProcessId</code>
                                        <div class="mt-1">
                                            <a asp-action="ProcessInstances" asp-route-deploymentKey="@item.Deployment.DeploymentId" class="btn btn-sm btn-outline-primary me-1">Instances</a>
                                            <a asp-action="Execute" asp-route-deploymentKey="@item.Deployment.DeploymentKey" asp-route-processId="@process.ProcessId" class="btn btn-sm btn-outline-success">Start</a>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="text-muted">No processes found in this deployment.</p>
                        }

                        <form asp-action="DeleteDefinition" method="post" class="mt-2">
                            <input type="hidden" name="deploymentKey" value="@item.Deployment.DeploymentId" />
                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Delete this deployment?');">Delete</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info">
        <h4>No deployments found</h4>
        <p>Upload a BPMN file to get started.</p>
    </div>
}
