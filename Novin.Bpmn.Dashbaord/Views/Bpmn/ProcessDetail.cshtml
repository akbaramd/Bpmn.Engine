@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Novin.Bpmn.Dashbaord.Models
@model ProcessDetailViewModel

<div class="container mt-4">
    <h1 class="mb-4">Process Execution Viewer</h1>

    <div class="row">
        <div class="col-md-4">
            <div class="card mb-3">
                <div class="card-header">Process Info</div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-5">Instance ID:</dt>
                        <dd class="col-sm-7">@Model.InstanceId</dd>

                        <dt class="col-sm-5">Definition Key:</dt>
                        <dd class="col-sm-7">@Model.DeploymentKey</dd>

                        <dt class="col-sm-5">Process ID:</dt>
                        <dd class="col-sm-7">@Model.ProcessId</dd>

                        <dt class="col-sm-5">Status:</dt>
                        <dd class="col-sm-7">@Model.Status</dd>

                        <dt class="col-sm-5">Start Time:</dt>
                        <dd class="col-sm-7">@Model.StartTime</dd>

                        @if (Model.EndTime != null)
                        {
                            <dt class="col-sm-5">End Time:</dt>
                            <dd class="col-sm-7">@Model.EndTime</dd>
                        }
                    </dl>
                </div>
            </div>

            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Variables</span>
                    <button class="btn btn-sm btn-outline-secondary" id="toggleVariables">Expand All</button>
                </div>
                <div class="card-body">
                    @if (Model.Variables is IDictionary<string, object> vars && vars.Any())
                    {
                        <div class="variables-container">
                            @foreach (var variable in vars)
                            {
                                <div class="variable-item mb-2">
                                    <div class="variable-header d-flex justify-content-between align-items-center p-2 rounded" 
                                         style="background-color: #f8f9fa; cursor: pointer;" 
                                         onclick="toggleVariableContent(this)">
                                        <span class="fw-bold">@variable.Key</span>
                                        <span class="badge bg-secondary">@(variable.Value?.GetType().Name ?? "null")</span>
                                    </div>
                                    <div class="variable-content p-2 border-start border-end border-bottom rounded-bottom" style="display: none;">
                                        @if (variable.Value != null)
                                        {
                                            <pre class="small text-wrap mb-0">@System.Text.Json.JsonSerializer.Serialize(variable.Value, new System.Text.Json.JsonSerializerOptions { WriteIndented = true })</pre>
                                        }
                                        else
                                        {
                                            <span class="text-muted">null</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                        <script>
                            function toggleVariableContent(header) {
                                const content = header.nextElementSibling;
                                if (content.style.display === 'none') {
                                    content.style.display = 'block';
                                } else {
                                    content.style.display = 'none';
                                }
                            }
                            
                            document.getElementById('toggleVariables').addEventListener('click', function() {
                                const contents = document.querySelectorAll('.variable-content');
                                const isAnyHidden = Array.from(contents).some(c => c.style.display === 'none');
                                
                                contents.forEach(content => {
                                    content.style.display = isAnyHidden ? 'block' : 'none';
                                });
                                
                                this.textContent = isAnyHidden ? 'Collapse All' : 'Expand All';
                            });
                        </script>
                    }
                    else
                    {
                        <p class="text-muted">No variables available.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card mb-3" style="height: 500px;">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Process Diagram</span>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="showVirtualNodes" checked>
                        <label class="form-check-label" for="showVirtualNodes">Show Virtual Paths</label>
                    </div>
                </div>
                <div id="canvas" style="height: 100%; position: relative;"></div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a asp-action="ProcessInstances" asp-route-deploymentKey="@Model.DeploymentKey" class="btn btn-secondary">Back to Instances</a>
    </div>
</div>

@section Scripts {
    <script src="~/js/bundle.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const pid     = '@Model.InstanceId';
            const chk     = document.getElementById('showVirtualNodes');

            bpmn.initializeViewer(pid, chk.checked);    // auto-refresh starts inside

            chk.addEventListener('change', () =>
                bpmn.updateExecutionMap(pid, chk.checked));
        });

    </script>
}